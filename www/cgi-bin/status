#!/bin/sh
# GET runtime status: { "running": bool, "version": "...", "config": "..." }
. /www/cgi-bin/_lib.sh

VER="$(mihomo -v 2>/dev/null | head -n1 | json_escape)"

# probe the API; /version returns {"version":"...","meta":true} when up
if api GET "/version" >/dev/null 2>&1; then
  RUNNING=true
else
  RUNNING=false
fi

EXT_UI="$(_yaml external-ui)"

# Состояние входа — из окружения, которое выставил entrypoint (CGI его наследуют)
AUTH_OFF=false;     [ "${WEB_AUTH:-on}" = "off" ]      && AUTH_OFF=true
AUTH_DEFAULT=false; [ "${WEB_AUTH_DEFAULT:-0}" = "1" ] && AUTH_DEFAULT=true

send_json "200 OK"
printf '{"running":%s,"version":"%s","config":"%s","apiPort":"%s","ui":"%s",'\
'"authOff":%s,"authDefault":%s,"user":"%s"}' \
  "$RUNNING" "$VER" "$(printf '%s' "$CONFIG" | json_escape)" \
  "$API_PORT" "$(printf '%s' "$EXT_UI" | json_escape)" \
  "$AUTH_OFF" "$AUTH_DEFAULT" "$(printf '%s' "${WEB_USER:-admin}" | json_escape)"
